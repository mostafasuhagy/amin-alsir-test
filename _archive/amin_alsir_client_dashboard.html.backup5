<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#FFE600">
<link rel="manifest" href="manifest_client.json">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="192x192" href="data:image/png;base64,">
<link rel="shortcut icon" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="أمين السر — عميل">
<title>أمين السر — لوحة العميل</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
<style>
html, body { overscroll-behavior: contain; touch-action: pan-y; }
:root{
  --navy:#0D1B4B;--navy2:#162258;--gold:#F5C518;--gold2:#E8B400;--yellow:#FFE600;
  --white:#FFFFFF;--gray:#94A3B8;--green:#22C55E;--blue:#4F8EF7;--red:#EF4444;
  --purple:#8B5CF6;--orange:#F97316;
  --glass:rgba(13,27,75,0.08);--glass2:rgba(13,27,75,0.15);
  --radius:16px;--font:'Tajawal',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{font-family:var(--font);background:var(--yellow);color:var(--navy);min-height:100vh;overflow-x:hidden;}
.bg{position:fixed;inset:0;z-index:0;background:linear-gradient(135deg,#FFE600 0%,#FFF176 50%,#FFE600 100%);}
.app{position:relative;z-index:1;max-width:480px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;}
#loading{position:fixed;inset:0;z-index:100;background:var(--yellow);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;transition:opacity 0.5s;}
#loading .logo-img{width:110px;height:110px;object-fit:contain;animation:pulse 1.5s infinite;filter:drop-shadow(0 0 18px rgba(13,27,75,0.3));}
#loading h2{font-size:24px;font-weight:800;color:var(--navy);}
#loading p{font-size:14px;color:var(--navy);opacity:0.6;}
.spinner{width:40px;height:40px;border:3px solid rgba(13,27,75,0.2);border-top-color:var(--navy);border-radius:50%;animation:spin 0.8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.header{padding:12px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;background:rgba(255,230,0,0.97);backdrop-filter:blur(20px);border-bottom:2px solid rgba(13,27,75,0.1);}
.header-right{display:flex;align-items:center;gap:10px;}
.header-logo-img{width:48px;height:48px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(13,27,75,0.25));}
.header-title h1{font-size:18px;font-weight:800;color:var(--navy);}
.header-title p{font-size:11px;color:var(--navy);opacity:0.5;margin-top:1px;}
.client-name-badge{background:var(--navy);color:var(--yellow);padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;}
.welcome-card{margin:16px 20px;background:var(--navy);border-radius:20px;padding:20px;display:flex;align-items:center;gap:16px;}
.welcome-avatar{width:56px;height:56px;border-radius:50%;background:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;}
.welcome-info h2{font-size:18px;font-weight:800;color:var(--white);}
.welcome-info p{font-size:12px;color:rgba(255,255,255,0.6);margin-top:4px;}
.welcome-info .client-code{font-size:11px;color:var(--gold);margin-top:4px;font-weight:700;}
.stats-bar{padding:0 20px 16px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.stat-card{background:var(--navy);border-radius:14px;padding:12px;text-align:center;cursor:pointer;transition:all 0.2s;}
.stat-card:active{transform:scale(0.96);}
.stat-card .num{font-size:24px;font-weight:900;color:var(--gold);}
.stat-card .lbl{font-size:10px;color:rgba(255,255,255,0.6);margin-top:2px;}
.section{padding:0 20px 16px;display:none;}
.section.active{display:block;}
.section-title{font-size:13px;font-weight:700;color:var(--navy);opacity:0.5;text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.section-title::after{content:'';flex:1;height:1px;background:rgba(13,27,75,0.12);}
.main-content{padding:16px 20px;flex:1;}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
.grid-1{margin-bottom:12px;}
.card{background:var(--navy);border-radius:var(--radius);padding:18px;cursor:pointer;transition:all 0.25s;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;right:0;width:60px;height:60px;border-radius:0 16px 0 60px;opacity:0.15;transition:opacity 0.25s;}
.card:active{transform:scale(0.97);}
.card:hover::before{opacity:0.25;}
.card.gold::before{background:var(--gold);}
.card.blue::before{background:var(--blue);}
.card.green::before{background:var(--green);}
.card.orange::before{background:var(--orange);}
.card.purple::before{background:var(--purple);}
.card-icon{font-size:32px;margin-bottom:10px;}
.card-title{font-size:15px;font-weight:700;color:var(--white);}
.card-sub{font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;}
.card-arrow{position:absolute;bottom:14px;left:14px;color:rgba(255,255,255,0.4);font-size:14px;}
.card-wide{display:flex;align-items:center;gap:16px;}
.card-wide .card-icon{font-size:36px;margin:0;}
.card-wide .card-info{flex:1;}
.card-wide .card-title{font-size:16px;}
.topic-list{display:flex;flex-direction:column;gap:10px;}
.topic-item{background:var(--navy);border-radius:14px;padding:16px;cursor:pointer;transition:all 0.2s;}
.topic-item:active{transform:scale(0.98);}
.topic-item .topic-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.topic-item .topic-code{font-size:12px;color:var(--gold);font-weight:700;}
.topic-item .topic-status{font-size:10px;font-weight:700;padding:3px 8px;border-radius:8px;}
.status-active{background:rgba(34,197,94,0.25);color:#4ade80;}
.status-new{background:rgba(79,142,247,0.25);color:#7eb3ff;}
.status-closed{background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);}
.topic-item .topic-name{font-size:15px;font-weight:700;color:var(--white);margin-bottom:4px;}
.topic-item .topic-meta{font-size:11px;color:rgba(255,255,255,0.5);}
.events-list{display:flex;flex-direction:column;gap:10px;}
.event-item{background:var(--navy);border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:14px;}
.event-date{background:rgba(245,197,24,0.2);border:1px solid rgba(245,197,24,0.4);border-radius:10px;padding:8px 10px;text-align:center;min-width:48px;}
.event-date .day{font-size:20px;font-weight:900;color:var(--gold);line-height:1;}
.event-date .month{font-size:10px;color:rgba(255,255,255,0.5);}
.event-info{flex:1;}
.event-info .title{font-size:14px;font-weight:700;color:var(--white);}
.event-info .sub{font-size:11px;color:rgba(255,255,255,0.5);margin-top:3px;}
.event-status{font-size:10px;font-weight:700;padding:3px 8px;border-radius:8px;}
.event-status.upcoming{background:rgba(79,142,247,0.25);color:#7eb3ff;}
.event-status.today{background:rgba(245,197,24,0.25);color:var(--gold);}
.notif-banner{background:var(--navy);border-radius:14px;padding:16px;display:flex;align-items:center;gap:12px;margin-bottom:12px;cursor:pointer;transition:all 0.2s;}
.notif-banner:active{transform:scale(0.98);}
.notif-banner .notif-icon{font-size:28px;}
.notif-banner .notif-text{flex:1;}
.notif-banner .notif-title{font-size:14px;font-weight:700;color:var(--gold);}
.notif-banner .notif-msg{font-size:12px;color:rgba(255,255,255,0.5);margin-top:3px;}
.notif-banner .notif-time{font-size:10px;color:rgba(255,255,255,0.3);}
.modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.5);backdrop-filter:blur(8px);display:none;align-items:flex-end;}
.modal-overlay.open{display:flex;}
.modal{width:100%;max-width:480px;margin:0 auto;background:var(--navy);border-radius:24px 24px 0 0;padding:20px 20px 40px;animation:slideUp 0.3s ease;max-height:90vh;overflow-y:auto;}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-handle{width:40px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin:0 auto 20px;}
.modal-title{font-size:20px;font-weight:800;margin-bottom:20px;display:flex;align-items:center;gap:10px;color:var(--white);}
.modal-close{margin-right:auto;background:rgba(255,255,255,0.1);border:none;color:rgba(255,255,255,0.5);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;}
.form-group{margin-bottom:16px;}
.form-label{font-size:12px;font-weight:700;color:rgba(255,255,255,0.5);margin-bottom:8px;display:block;}
.form-input{width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:14px 16px;color:var(--white);font-family:var(--font);font-size:15px;outline:none;transition:border-color 0.2s;text-align:right;}
.form-input:focus{border-color:var(--gold);}
.form-input::placeholder{color:rgba(255,255,255,0.3);}
.btn-primary{width:100%;background:linear-gradient(135deg,var(--gold),var(--gold2));color:var(--navy);border:none;border-radius:14px;padding:16px;font-family:var(--font);font-size:16px;font-weight:800;cursor:pointer;margin-top:8px;}
.btn-secondary{width:100%;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:var(--white);border-radius:14px;padding:14px;font-family:var(--font);font-size:15px;font-weight:700;cursor:pointer;margin-top:8px;}
.bottom-nav{position:sticky;bottom:0;background:rgba(255,230,0,0.97);backdrop-filter:blur(20px);border-top:2px solid rgba(13,27,75,0.1);padding:12px 20px 24px;display:grid;grid-template-columns:repeat(3,1fr);gap:4px;}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;padding:8px 4px;border-radius:12px;transition:all 0.2s;border:none;background:transparent;}
.nav-item.active{background:var(--navy);}
.nav-icon{font-size:22px;}
.nav-label{font-size:10px;color:rgba(13,27,75,0.5);font-family:var(--font);}
.nav-item.active .nav-label{color:var(--gold);}
.toast{position:fixed;top:80px;left:50%;transform:translateX(-50%);background:var(--green);color:var(--white);padding:12px 24px;border-radius:50px;font-size:14px;font-weight:700;z-index:300;display:none;}
.toast.error{background:var(--red);}
.empty-state{text-align:center;padding:40px 20px;color:rgba(13,27,75,0.4);}
.empty-state .icon{font-size:48px;margin-bottom:12px;}
.empty-state p{font-size:14px;}
.select-list{display:flex;flex-direction:column;gap:8px;max-height:200px;overflow-y:auto;margin-bottom:12px;}
.select-item{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:12px 16px;cursor:pointer;transition:all 0.2s;display:flex;justify-content:space-between;align-items:center;}
.select-item.selected{border-color:var(--gold);background:rgba(245,197,24,0.15);}
.select-item .item-name{font-size:14px;font-weight:700;color:var(--white);}
.select-item .item-code{font-size:11px;color:var(--gold);margin-top:2px;}
</style>
</head>
<body>
<div id="loading">
  <img class="logo-img" src="data:image/png;base64," alt="أمين السر">
  <h2>أمين السر</h2>
  <p>لوحة العميل — جاري التحميل...</p>
  <div class="spinner"></div>
</div>
<div class="toast" id="toast"></div>
<div class="app">
  <header class="header">
    <div class="header-right">
      <img class="header-logo-img" src="data:image/png;base64," alt="أمين السر">
      <div class="header-title">
        <h1>أمين السر</h1>
        <p>بوابة العميل</p>
      </div>
    </div>
    <div class="client-name-badge" id="clientBadge">عميل</div>
  </header>
  <div class="welcome-card">
    <div class="welcome-avatar">👤</div>
    <div class="welcome-info">
      <h2 id="welcomeName">مرحباً بك</h2>
      <p>مكتب المحاماة — أمين السر</p>
      <div class="client-code" id="welcomeCode">جاري التحميل...</div>
    </div>
  </div>
  <div class="stats-bar">
    <div class="stat-card" onclick="showSection('topics')"><div class="num" id="statTopics">—</div><div class="lbl">موضوع نشط</div></div>
    <div class="stat-card" onclick="showSection('events')"><div class="num" id="statEvents">—</div><div class="lbl">حدث قادم</div></div>
    <div class="stat-card" onclick="showSection('notifications')"><div class="num" id="statNotifs">—</div><div class="lbl">إشعار جديد</div></div>
  </div>
  <div class="section active" id="sec-main">
    <div class="main-content">
<div style="background:#0D1B4B;border-radius:14px;padding:16px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;"><div><div style="font-size:14px;font-weight:700;color:#fff;">🔗 ربط حسابي بالبوت</div><div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:4px;">اربط حسابك لاستقبال الإشعارات</div></div><button onclick="linkAccount()" style="background:linear-gradient(135deg,#F5C518,#E8B400);color:#3D2E00;border:none;border-radius:10px;padding:10px 16px;font-family:Tajawal,sans-serif;font-size:13px;font-weight:800;cursor:pointer;">ربط الآن</button></div>
      <div class="section-title">🔔 آخر الإشعارات</div>
      <div id="notifBanners">
        <div class="notif-banner" onclick="showSection('notifications')">
          <div class="notif-icon">📢</div>
          <div class="notif-text"><div class="notif-title">مرحباً بك في أمين السر</div><div class="notif-msg">يمكنك متابعة قضاياك وأحداثك من هنا</div></div>
          <div class="notif-time">الآن</div>
        </div>
      </div>
      <div class="section-title">📅 أحداث قضاياك القادمة</div>
      <div class="events-list" id="eventsHome"><div class="empty-state"><div class="icon">⏳</div><p>جاري التحميل...</p></div></div>
      <div class="section-title" style="margin-top:16px">⚡ إجراءات</div>
      <div class="grid-1">
        <div class="card wide gold" onclick="openModal('sendShipment')">
          <div class="card-icon">📦</div>
          <div class="card-info"><div class="card-title">إرسال مرفقات</div><div class="card-sub">إرسال مستندات لمكتب المحاماة</div></div>
          <div class="card-arrow">←</div>
        </div>
      </div>
      <div class="grid-2">
        <div class="card blue" onclick="showSection('topics')"><div class="card-icon">📋</div><div class="card-title">قضاياي</div><div class="card-sub">متابعة الموضوعات</div><div class="card-arrow">←</div></div>
        <div class="card orange" onclick="openModal('notifyBoss')"><div class="card-icon">🔔</div><div class="card-title">إشعار للمحامي</div><div class="card-sub">يصله فوراً على تيليجرام</div><div class="card-arrow">←</div></div>
      </div>
    </div>
  </div>
  <div class="section" id="sec-topics"><div class="main-content"><div class="section-title">📋 قضاياي</div><div class="topic-list" id="topicsList"><div class="empty-state"><div class="icon">⏳</div><p>جاري التحميل...</p></div></div></div></div>
  <div class="section" id="sec-events"><div class="main-content"><div class="section-title">📅 أحداث قضاياي</div><div class="events-list" id="allEventsList"><div class="empty-state"><div class="icon">⏳</div><p>جاري التحميل...</p></div></div></div></div>
  <div class="section" id="sec-notifications"><div class="main-content"><div class="section-title">🔔 الإشعارات</div><div id="allNotifsList"><div class="notif-banner"><div class="notif-icon">📢</div><div class="notif-text"><div class="notif-title">مرحباً بك في أمين السر</div><div class="notif-msg">يمكنك متابعة قضاياك وأحداثك من هنا بكل سهولة</div></div><div class="notif-time">الآن</div></div></div></div></div>
  <nav class="bottom-nav">
    <button class="nav-item active" onclick="showSection('main')" id="nav-main"><span class="nav-icon">🏠</span><span class="nav-label">الرئيسية</span></button>
    <button class="nav-item" onclick="showSection('topics')" id="nav-topics"><span class="nav-icon">📋</span><span class="nav-label">قضاياي</span></button>
    <button class="nav-item" onclick="showSection('events')" id="nav-events"><span class="nav-icon">📅</span><span class="nav-label">الأحداث</span></button>
  </nav>
</div>
<div class="modal-overlay" id="modal-sendShipment" onclick="closeModal('sendShipment')">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-handle"></div>
    <div class="modal-title">📦 إرسال مرفقات<button class="modal-close" onclick="closeModal('sendShipment')">✕</button></div>
    <div class="form-group"><label class="form-label">اختر الموضوع</label><div class="select-list" id="topicSelectList"><div class="empty-state"><div class="icon">⏳</div><p>جاري التحميل...</p></div></div></div>
    <div class="form-group"><label class="form-label">وصف المرفقات</label><textarea class="form-input" id="shipDesc" placeholder="ما الذي ستُرسله؟" rows="3" style="resize:none"></textarea></div>
    <div class="form-group"><label class="form-label">ملاحظات إضافية (اختياري)</label><input class="form-input" id="shipNotes" placeholder="أي ملاحظات للمحامي..."></div>
    <button class="btn-primary" onclick="sendShipment()">📤 إرسال الطلب</button>
    <button class="btn-secondary" onclick="closeModal('sendShipment')">إلغاء</button>
  </div>
</div>
<div class="modal-overlay" id="modal-notifyBoss" onclick="closeModal('notifyBoss')">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-handle"></div>
    <div class="modal-title">🔔 إشعار للمحامي<button class="modal-close" onclick="closeModal('notifyBoss')">✕</button></div>
    <p style="color:rgba(255,255,255,0.5);font-size:13px;margin-bottom:16px">ستصل رسالتك مباشرة لمكتب المحاماة على تيليجرام فوراً 📲</p>
    <div class="form-group"><label class="form-label">موضوع الرسالة</label><input class="form-input" id="notifSubject" placeholder="مثال: استفسار عن القضية / طلب موعد"></div>
    <div class="form-group"><label class="form-label">نص الرسالة</label><textarea class="form-input" id="notifMsg" placeholder="اكتب رسالتك هنا..." rows="4" style="resize:none"></textarea></div>
    <div id="notifStatus" style="display:none;padding:12px;border-radius:12px;font-size:13px;margin-top:8px;text-align:center"></div>
    <button class="btn-primary" id="notifSendBtn" onclick="sendNotify()">📤 إرسال للمحامي الآن</button>
    <button class="btn-secondary" onclick="closeModal('notifyBoss')">إلغاء</button>
  </div>
</div>
<div class="modal-overlay" id="modal-topicDetails" onclick="closeModal('topicDetails')">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-handle"></div>
    <div class="modal-title">📋 تفاصيل القضية<button class="modal-close" onclick="closeModal('topicDetails')">✕</button></div>
    <div id="topicDetailsContent"></div>
    <button class="btn-secondary" onclick="closeModal('topicDetails')">إغلاق</button>
  </div>
</div>
<script>
function getSheetIdFromUrl() {
  const params = new URLSearchParams(window.location.search);
  const sid = params.get('sid');
  if (sid) { localStorage.setItem('clientSheetId', sid); return sid; }
  return localStorage.getItem('clientSheetId') || '1NvrC7PUQZreA9sATJCK4fgb06067NYmQPBaZVS0qSBk';
}
const SHEET_ID=getSheetIdFromUrl();
const SCRIPT_URL='https://script.google.com/macros/s/AKfycbymzKVmGgxqgJBFVf91HGzieUsNJQtEU9E1xu97Jkb73Q9VxycorCXDca1laq3Uwdfw/exec';
function getClientCode(){const params=new URLSearchParams(window.location.search);const token=params.get('t');if(token){const chatId=atob(token);localStorage.setItem('clientChatId',chatId);return chatId;}return localStorage.getItem('clientChatId')||null;}
const CLIENT_CHAT_ID=getClientCode();
const BOT_TOKEN='8716122412:AAHREvaHnoYsydnaPevVa5JDrT0wnxzz3Mk';
const BOSS_CHAT_ID='8653723225';
let CLIENT_CODE = null;
let CLIENT_NAME = 'العميل الكريم';

async function resolveClient(){
  const params = new URLSearchParams(window.location.search);
  const urlCode = params.get('c');
  const clients = await fetchSheet('Clients');
  let found = null;
  if (urlCode) {
    found = clients.find(c => c.client_code === urlCode);
  }
  if (!found && CLIENT_CHAT_ID) {
    found = clients.find(c => String(c.telegram_chat_id || '').trim() === String(CLIENT_CHAT_ID).trim());
  }
  if (found) {
    CLIENT_CODE = found.client_code;
    CLIENT_NAME = found.client_name || 'العميل الكريم';
    return true;
  }
  return false;
}
let allTopics=[],allEvents=[],selectedTopic=null;
window.onload=async()=>{
  const ok = await resolveClient();
  if (!ok) {
    document.getElementById('loading').innerHTML = 'Please open this dashboard from the link your office sent you on Telegram.';
    return;
  }
  updateClientInfo();
  await loadAllData();
  document.getElementById('loading').style.opacity='0';
  setTimeout(()=>document.getElementById('loading').style.display='none',500);
};
function updateClientInfo(){document.getElementById('clientBadge').textContent=CLIENT_CODE;document.getElementById('welcomeName').textContent='مرحباً، '+CLIENT_NAME;document.getElementById('welcomeCode').textContent='🔹 الكود: '+CLIENT_CODE;}
async function fetchSheet(name){try{const url=`https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(name)}`;const res=await fetch(url);const csv=await res.text();return parseCSV(csv);}catch(e){return[];}}
function parseCSV(csv){const lines=csv.trim().split('\n');if(lines.length<2)return[];const headers=lines[0].split(',').map(h=>h.replace(/"/g,'').trim());return lines.slice(1).map(line=>{const vals=parseCSVLine(line);const obj={};headers.forEach((h,i)=>obj[h]=(vals[i]||'').replace(/"/g,'').trim());return obj;}).filter(r=>Object.values(r).some(v=>v));}
function parseCSVLine(line){const result=[];let cur='';let inQ=false;for(let c of line){if(c==='"')inQ=!inQ;else if(c===','&&!inQ){result.push(cur);cur='';}else cur+=c;}result.push(cur);return result;}
function parseDate(str){if(!str)return null;const d=new Date(str.includes('/')?str.split('/').reverse().join('-'):str);return isNaN(d)?null:d;}
async function loadAllData(){const[topics,events]=await Promise.all([fetchSheet('Topics'),fetchSheet('Events')]);allTopics=topics.filter(t=>t.client_code===CLIENT_CODE);allEvents=events.filter(e=>allTopics.some(t=>t.topic_code===e.topic_code));updateStats();renderEventsHome();renderTopics();renderAllEvents();renderTopicSelect();}
function updateStats(){const active=allTopics.filter(t=>t.status!=='مؤرشف'&&t.status!=='منتهي');document.getElementById('statTopics').textContent=active.length||'0';const today=new Date();today.setHours(0,0,0,0);const upcoming=allEvents.filter(e=>{const d=parseDate(e.event_date);return d&&d>=today;});document.getElementById('statEvents').textContent=upcoming.length||'0';document.getElementById('statNotifs').textContent='1';}
function renderEventsHome(){const container=document.getElementById('eventsHome');const today=new Date();today.setHours(0,0,0,0);const upcoming=allEvents.filter(e=>{const d=parseDate(e.event_date);return d&&d>=today;}).sort((a,b)=>parseDate(a.event_date)-parseDate(b.event_date)).slice(0,3);if(!upcoming.length){container.innerHTML='<div class="empty-state"><div class="icon">✅</div><p>لا توجد أحداث قادمة</p></div>';return;}container.innerHTML=upcoming.map(e=>{const d=parseDate(e.event_date);const isToday=d&&d.toDateString()===today.toDateString();const day=d?d.getDate():'—';const month=d?d.toLocaleString('ar',{month:'short'}):'';return`<div class="event-item"><div class="event-date"><div class="day">${day}</div><div class="month">${month}</div></div><div class="event-info"><div class="title">${e.event_type||'—'}</div><div class="sub">${e.location_court?'📍 '+e.location_court:''}</div></div><span class="event-status ${isToday?'today':'upcoming'}">${isToday?'اليوم':'قادم'}</span></div>`;}).join('');}
function renderTopics(){const container=document.getElementById('topicsList');if(!allTopics.length){container.innerHTML='<div class="empty-state"><div class="icon">📋</div><p>لا توجد قضايا مسجلة</p></div>';return;}const sc={'جديد':'status-new','قيد النظر':'status-active','منتهي':'status-closed','مؤرشف':'status-closed'};container.innerHTML=allTopics.map(t=>`<div class="topic-item" onclick="showTopicDetails('${t.topic_code}')"><div class="topic-header"><span class="topic-code">${t.topic_code}</span><span class="topic-status ${sc[t.status]||'status-new'}">${t.status||'جديد'}</span></div><div class="topic-name">${t.service_name||'—'}</div><div class="topic-meta">📅 ${t.date_opened||'—'} · 📌 ${t.notes||'—'}</div></div>`).join('');}
function renderAllEvents(){const container=document.getElementById('allEventsList');if(!allEvents.length){container.innerHTML='<div class="empty-state"><div class="icon">📅</div><p>لا توجد أحداث</p></div>';return;}container.innerHTML=allEvents.map(e=>`<div class="event-item"><div class="event-date"><div class="day">${parseDate(e.event_date)?.getDate()||'—'}</div><div class="month">${parseDate(e.event_date)?.toLocaleString('ar',{month:'short'})|| ''}</div></div><div class="event-info"><div class="title">${e.event_type||'—'}</div><div class="sub">📋 ${e.topic_code||''} ${e.location_court?'· 📍'+e.location_court:''}</div></div><span class="event-status upcoming">قادم</span></div>`).join('');}
function renderTopicSelect(){const container=document.getElementById('topicSelectList');const active=allTopics.filter(t=>t.status!=='مؤرشف'&&t.status!=='منتهي');if(!active.length){container.innerHTML='<div class="empty-state"><div class="icon">📋</div><p>لا توجد موضوعات</p></div>';return;}container.innerHTML=active.map(t=>`<div class="select-item" onclick="selectTopic('${t.topic_code}','${t.service_name}',this)"><div><div class="item-name">${t.service_name||'—'}</div><div class="item-code">${t.topic_code}</div></div><span>○</span></div>`).join('');}
function selectTopic(code,name,el){document.querySelectorAll('.select-item').forEach(i=>{i.classList.remove('selected');i.querySelector('span').textContent='○';});el.classList.add('selected');el.querySelector('span').textContent='✅';selectedTopic={code,name};}
function showTopicDetails(code){const t=allTopics.find(t=>t.topic_code===code);if(!t)return;const topicEvents=allEvents.filter(e=>e.topic_code===code);document.getElementById('topicDetailsContent').innerHTML=`<div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:16px;margin-bottom:16px"><div style="font-size:12px;color:var(--gold);font-weight:700;margin-bottom:8px">${t.topic_code}</div><div style="font-size:17px;font-weight:800;margin-bottom:12px;color:var(--white)">${t.service_name||'—'}</div><div style="font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:6px">📅 تاريخ الفتح: ${t.date_opened||'—'}</div><div style="font-size:12px;color:rgba(255,255,255,0.5);margin-bottom:6px">📌 النوع: ${t.notes||'—'}</div><div style="font-size:12px;color:rgba(255,255,255,0.5)">👨‍💼 المساعد: ${t.assistant_name||'—'}</div></div><div style="font-size:13px;font-weight:700;color:rgba(255,255,255,0.4);margin-bottom:10px">📅 الأحداث (${topicEvents.length})</div>${topicEvents.length?topicEvents.map(e=>`<div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:12px;margin-bottom:8px"><div style="font-size:14px;font-weight:700;color:var(--white)">${e.event_type||'—'}</div><div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:4px">📅 ${e.event_date||'—'} ${e.event_time?'· ⏰'+e.event_time:''}</div><div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px">${e.location_court?'📍 '+e.location_court:''}</div></div>`).join(''):'<div class="empty-state"><div class="icon">📅</div><p>لا توجد أحداث لهذه القضية</p></div>'}`;openModal('topicDetails');}
async function postToSheet(sheet,row){try{await fetch(SCRIPT_URL,{method:'POST',body:JSON.stringify({sheet,row,sheet_id:SHEET_ID})});return true;}catch(e){return false;}}
async function sendShipment(){if(!selectedTopic){showToast('❌ يرجى اختيار الموضوع أولاً',true);return;}const desc=document.getElementById('shipDesc').value.trim();const notes=document.getElementById('shipNotes').value.trim();if(!desc){showToast('❌ يرجى كتابة وصف المرفقات',true);return;}closeModal('sendShipment');const now=new Date().toLocaleDateString('en-CA');await postToSheet('Shipments',['',selectedTopic.code,CLIENT_NAME,'',now,desc,'','','معلق','',notes||'—']);showToast('✅ تم إرسال طلب المرفقات!');selectedTopic=null;document.getElementById('shipDesc').value='';document.getElementById('shipNotes').value='';document.querySelectorAll('.select-item').forEach(i=>{i.classList.remove('selected');i.querySelector('span').textContent='○';});}
async function sendNotify(){const subject=document.getElementById('notifSubject').value.trim();const msg=document.getElementById('notifMsg').value.trim();if(!subject||!msg){showToast('❌ يرجى ملء جميع الحقول',true);return;}const btn=document.getElementById('notifSendBtn');const status=document.getElementById('notifStatus');btn.textContent='⏳ جاري الإرسال...';btn.disabled=true;status.style.display='block';status.style.background='rgba(79,142,247,0.15)';status.style.color='var(--blue)';status.textContent='جاري إرسال الإشعار للمحامي...';const text=`🔔 *إشعار من العميل*\n\n👤 العميل: ${CLIENT_NAME}\n🔹 الكود: ${CLIENT_CODE}\n\n📌 *الموضوع:* ${subject}\n\n📝 *الرسالة:*\n${msg}\n\n⏰ ${new Date().toLocaleString('ar-EG')}`;try{const res=await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({chat_id:BOSS_CHAT_ID,text,parse_mode:'Markdown'})});const data=await res.json();if(data.ok){status.style.background='rgba(34,197,94,0.15)';status.style.color='var(--green)';status.textContent='✅ تم إرسال الإشعار للمحامي بنجاح!';setTimeout(()=>{closeModal('notifyBoss');showToast('✅ وصل إشعارك للمحامي!');document.getElementById('notifSubject').value='';document.getElementById('notifMsg').value='';},1500);}else{throw new Error(data.description);}}catch(e){status.style.background='rgba(239,68,68,0.15)';status.style.color='var(--red)';status.textContent='❌ حدث خطأ في الإرسال — حاول مرة أخرى';}finally{btn.textContent='📤 إرسال للمحامي الآن';btn.disabled=false;setTimeout(()=>status.style.display='none',3000);}}
function showSection(name){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));const sec=document.getElementById('sec-'+name);const nav=document.getElementById('nav-'+name);if(sec)sec.classList.add('active');if(nav)nav.classList.add('active');window.scrollTo(0,0);}
function openModal(name){document.getElementById('modal-'+name).classList.add('open');}
function closeModal(name){document.getElementById('modal-'+name).classList.remove('open');}
function linkAccount(){const chatId=CLIENT_CHAT_ID;if(chatId){showToast('✅ حسابك مرتبط بالفعل!');return;}const url='https://t.me/amin_alsir_bot?start=client_'+encodeURIComponent(window.location.search);window.open(url,'_blank');}
function showToast(msg,isError=false){const t=document.getElementById('toast');t.textContent=msg;t.className='toast'+(isError?' error':'');t.style.display='block';setTimeout(()=>t.style.display='none',3000);}
</script>









<script>
/* منع الرجوع للصفحات القديمة على متصفحات الموبايل
   الطريقة: history.go(1) يرجع للأمام فور ما المتصفح يحاول الرجوع */
(function() {
  history.pushState(null, null, window.location.href);

  window.addEventListener('popstate', function() {
    history.go(1);
  });

  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      window.location.reload();
    }
  });
})();
</script>

<script>
(function() {
  var STORAGE_KEY = 'aminalsir_client_url';
  var params = new URLSearchParams(window.location.search);
  var t = params.get('t'); var sid = params.get('sid');
  if (t && sid) {
    try { localStorage.setItem(STORAGE_KEY, window.location.href); } catch(e) {}
  } else {
    var savedUrl = null;
    try { savedUrl = localStorage.getItem(STORAGE_KEY); } catch(e) {}
    if (savedUrl) { window.location.replace(savedUrl); return; }
    else {
      document.addEventListener('DOMContentLoaded', function() {
        document.body.style.cssText = 'margin:0;background:#ffd700;display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:Arial,sans-serif;direction:rtl';
        document.body.innerHTML = '<div style="text-align:center;padding:30px;max-width:320px"><div style="font-size:60px;margin-bottom:20px">🔐</div><h2 style="color:#0D1B4B;margin-bottom:15px">أمين السر</h2><p style="color:#333;font-size:16px;line-height:1.6">يرجى فتح لوحة العميل من الرابط الذي أرسله لك المكتب عبر تيليجرام</p></div>';
      });
      return;
    }
  }
  history.pushState(null, null, window.location.href);
  window.addEventListener('popstate', function() { history.go(1); });
  window.addEventListener('pageshow', function(event) { if (event.persisted) { window.location.reload(); } });
})();
</script>
</body>
</html>